\cb3     a = np.where(quiet, np.clip(q, \cf6 \strokec6 0\cf4 \strokec4 , np.percentile(qq, \cf6 \strokec6 99.9\cf4 \strokec4 )) - qq.mean(), \cf6 \strokec6 0.0\cf4 \strokec4 )\cb1 \
\cb3     n = \cf9 \strokec9 len\cf4 \strokec4 (a)\cb1 \
\
\cb3     \cf7 \strokec7 def\cf4 \strokec4  \cf9 \strokec9 acf\cf4 \strokec4 (\cf10 \strokec10 v\cf4 \strokec4 ):\cb1 \
\cb3         F = np.fft.rfft(v, \cf6 \strokec6 2\cf4 \strokec4  * n)\cb1 \
\cb3         \cf8 \strokec8 return\cf4 \strokec4  np.fft.irfft(F * np.conj(F))[:n]\cb1 \
