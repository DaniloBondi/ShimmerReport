\cb3     az = \cf6 \strokec6 0\cf4 \cb1 \strokec4 \
\cb3     \cf8 \strokec8 for\cf4 \strokec4  x \cf7 \strokec7 in\cf4 \strokec4  xs:\cb1 \
\cb3         z = signal.sosfiltfilt(sos, x - np.median(x))\cb1 \
\cb3         az = az + np.\cf9 \strokec9 abs\cf4 \strokec4 (z) / \cf9 \strokec9 max\cf4 \strokec4 (_rsigma(z), \cf6 \strokec6 1e-12\cf4 \strokec4 )\cb1 \
